<!DOCTYPE html>
<html lang="id">
<head>
  <meta charset="UTF-8">
  <!-- Kunci tampilan ke Landscape di Perangkat Mobile -->
  <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no, viewport-fit=cover">
  <title>Cell Defense Mobile Landscape Edition</title>
  <style>
    * {
      box-sizing: border-box;
      margin: 0;
      padding: 0;
      user-select: none;
      -webkit-user-select: none;
      touch-action: none; /* Mencegah zoom/scroll saat menyentuh tombol di HP */
    }
    body, html {
      width: 100%;
      height: 100%;
      background-color: #050103;
      color: #fff;
      font-family: 'Segoe UI', system-ui, -apple-system, sans-serif;
      overflow: hidden;
      display: flex;
      align-items: center;
      justify-content: center;
    }

    /* Container selalu memaksa rasio Landscape (16:9) */
    #game-wrapper {
      position: relative;
      width: 100vw;
      height: 56.25vw; /* Rasio 16:9 */
      max-height: 100vh;
      max-width: 177.78vh; /* 16:9 Rasio terbalik */
      box-shadow: 0 0 30px rgba(255, 0, 85, 0.4);
      background: #000;
    }

    canvas {
      width: 100%;
      height: 100%;
      display: block;
      background: radial-gradient(circle at center, #2b0415 0%, #080105 100%);
    }

    /* UI Overlay */
    .ui-top {
      position: absolute;
      top: 12px;
      left: 16px;
      right: 16px;
      display: flex;
      justify-content: space-between;
      pointer-events: none;
      z-index: 10;
    }
    .stat-badge {
      background: rgba(15, 3, 9, 0.75);
      backdrop-filter: blur(6px);
      padding: 8px 16px;
      border-radius: 20px;
      border: 1px solid rgba(255, 255, 255, 0.15);
      font-size: 14px;
      font-weight: 700;
    }

    /* --- TOMBOL ON-SCREEN KONTROL HP (TOUCH CONTROLS) --- */
    .touch-controls {
      position: absolute;
      bottom: 15px;
      left: 0;
      width: 100%;
      height: 140px;
      pointer-events: none;
      display: flex;
      justify-content: space-between;
      padding: 0 20px;
      z-index: 20;
    }

    /* D-PAD Navigasi Gerak (Kiri) */
    .dpad {
      pointer-events: auto;
      position: relative;
      width: 130px;
      height: 130px;
    }
    .dpad-btn {
      position: absolute;
      background: rgba(255, 255, 255, 0.15);
      border: 2px solid rgba(255, 255, 255, 0.3);
      border-radius: 12px;
      display: flex;
      align-items: center;
      justify-content: center;
      font-size: 20px;
      color: white;
      backdrop-filter: blur(4px);
    }
    .dpad-btn:active {
      background: rgba(0, 240, 255, 0.4);
      border-color: #00ffff;
    }
    #btn-up { top: 0; left: 42px; width: 46px; height: 42px; }
    #btn-down { bottom: 0; left: 42px; width: 46px; height: 42px; }
    #btn-left { top: 42px; left: 0; width: 42px; height: 46px; }
    #btn-right { top: 42px; right: 0; width: 42px; height: 46px; }

    /* Tombol Tembak (Kanan) */
    .shoot-area {
      pointer-events: auto;
      display: flex;
      align-items: flex-end;
    }
    .btn-shoot {
      width: 85px;
      height: 85px;
      border-radius: 50%;
      background: radial-gradient(circle, #ff0055 0%, #aa0033 100%);
      border: 3px solid rgba(255, 255, 255, 0.5);
      box-shadow: 0 0 20px rgba(255, 0, 85, 0.6);
      color: white;
      font-weight: bold;
      font-size: 14px;
      display: flex;
      align-items: center;
      justify-content: center;
      letter-spacing: 1px;
    }
    .btn-shoot:active {
      transform: scale(0.92);
      background: #ff3300;
    }

    /* Screen Game Over */
    #game-over-screen {
      position: absolute;
      top: 0; left: 0; width: 100%; height: 100%;
      background: rgba(8, 1, 4, 0.92);
      backdrop-filter: blur(8px);
      display: flex;
      flex-direction: column;
      align-items: center;
      justify-content: center;
      z-index: 30;
    }
    #game-over-screen h1 {
      font-size: 32px; color: #ff3366; margin-bottom: 6px;
      text-shadow: 0 0 15px rgba(255, 51, 102, 0.6);
    }
    #game-over-screen p { font-size: 15px; margin-bottom: 20px; color: #ccc; }
    .btn-restart {
      background: linear-gradient(135deg, #ff0055, #ff5500);
      color: white; border: none; padding: 12px 30px;
      font-size: 15px; font-weight: bold; border-radius: 25px;
      cursor: pointer; box-shadow: 0 5px 20px rgba(255, 0, 85, 0.5);
    }

    .hidden { display: none !important; }
  </style>
</head>
<body>

  <div id="game-wrapper">
    <canvas id="gameCanvas" width="960" height="540"></canvas>

    <!-- Top UI -->
    <div class="ui-top">
      <div class="stat-badge" style="color: #55ff99;">🛡️ Sel Imun: <span id="hpVal">100</span>%</div>
      <div class="stat-badge" style="color: #ffdd44;">🦠 Virus Terbasmi: <span id="scoreVal">0</span></div>
    </div>

    <!-- On-Screen Touch Controls (Aktif di HP & Tablet) -->
    <div class="touch-controls">
      <div class="dpad">
        <div class="dpad-btn" id="btn-up">▲</div>
        <div class="dpad-btn" id="btn-down">▼</div>
        <div class="dpad-btn" id="btn-left">◀</div>
        <div class="dpad-btn" id="btn-right">▶</div>
      </div>
      <div class="shoot-area">
        <div class="btn-shoot" id="btn-shoot">TEMBAK</div>
      </div>
    </div>

    <!-- Game Over Screen -->
    <div id="game-over-screen" class="hidden">
      <h1>Infeksi Meluas!</h1>
      <p>Total Patogen Terbasmi: <span id="finalScore">0</span></p>
      <button class="btn-restart" onclick="restartGame()">Injeksi Vaksin & Main Lagi</button>
    </div>
  </div>

  <script>
    const canvas = document.getElementById('gameCanvas');
    const ctx = canvas.getContext('2d');

    const hpVal = document.getElementById('hpVal');
    const scoreVal = document.getElementById('scoreVal');
    const gameOverScreen = document.getElementById('game-over-screen');
    const finalScore = document.getElementById('finalScore');

    let gameActive = true;
    let score = 0;
    let hp = 100;
    let time = 0;

    // --- SINTESIS SUARA (WEB AUDIO API - SOUND EFFECTS) ---
    const AudioContext = window.AudioContext || window.webkitAudioContext;
    const audioCtx = new AudioContext();

    function playSound(type) {
      if (audioCtx.state === 'suspended') audioCtx.resume();
      const osc = audioCtx.createOscillator();
      const gain = audioCtx.createGain();
      osc.connect(gain);
      gain.connect(audioCtx.destination);

      if (type === 'shoot') {
        osc.type = 'sine';
        osc.frequency.setValueAtTime(600, audioCtx.currentTime);
        osc.frequency.exponentialRampToValueAtTime(100, audioCtx.currentTime + 0.15);
        gain.gain.setValueAtTime(0.2, audioCtx.currentTime);
        gain.gain.linearRampToValueAtTime(0.01, audioCtx.currentTime + 0.15);
        osc.start(); osc.stop(audioCtx.currentTime + 0.15);
      } else if (type === 'hit') {
        osc.type = 'square';
        osc.frequency.setValueAtTime(150, audioCtx.currentTime);
        osc.frequency.exponentialRampToValueAtTime(30, audioCtx.currentTime + 0.2);
        gain.gain.setValueAtTime(0.3, audioCtx.currentTime);
        gain.gain.linearRampToValueAtTime(0.01, audioCtx.currentTime + 0.2);
        osc.start(); osc.stop(audioCtx.currentTime + 0.2);
      } else if (type === 'damage') {
        osc.type = 'sawtooth';
        osc.frequency.setValueAtTime(100, audioCtx.currentTime);
        osc.frequency.linearRampToValueAtTime(40, audioCtx.currentTime + 0.3);
        gain.gain.setValueAtTime(0.4, audioCtx.currentTime);
        gain.gain.linearRampToValueAtTime(0.01, audioCtx.currentTime + 0.3);
        osc.start(); osc.stop(audioCtx.currentTime + 0.3);
      }
    }

    // --- SYSTEM CONTROLS (D-Pad + Keyboard) ---
    const keys = { up: false, down: false, left: false, right: false };

    // Handler Keyboard (Laptop / PC)
    window.addEventListener('keydown', e => {
      if (e.key === 'ArrowUp' || e.key === 'w') keys.up = true;
      if (e.key === 'ArrowDown' || e.key === 's') keys.down = true;
      if (e.key === 'ArrowLeft' || e.key === 'a') keys.left = true;
      if (e.key === 'ArrowRight' || e.key === 'd') keys.right = true;
      if (e.key === ' ' || e.key === 'Enter') shootAntibody();
    });
    window.addEventListener('keyup', e => {
      if (e.key === 'ArrowUp' || e.key === 'w') keys.up = false;
      if (e.key === 'ArrowDown' || e.key === 's') keys.down = false;
      if (e.key === 'ArrowLeft' || e.key === 'a') keys.left = false;
      if (e.key === 'ArrowRight' || e.key === 'd') keys.right = false;
    });

    // Handler Touch Buttons (HP / Tablet)
    function setupTouchBtn(id, keyName) {
      const btn = document.getElementById(id);
      btn.addEventListener('touchstart', (e) => { e.preventDefault(); keys[keyName] = true; });
      btn.addEventListener('touchend', (e) => { e.preventDefault(); keys[keyName] = false; });
      btn.addEventListener('mousedown', () => { keys[keyName] = true; });
      btn.addEventListener('mouseup', () => { keys[keyName] = false; });
    }
    setupTouchBtn('btn-up', 'up');
    setupTouchBtn('btn-down', 'down');
    setupTouchBtn('btn-left', 'left');
    setupTouchBtn('btn-right', 'right');

    const shootBtn = document.getElementById('btn-shoot');
    shootBtn.addEventListener('touchstart', (e) => { e.preventDefault(); shootAntibody(); });
    shootBtn.addEventListener('mousedown', () => { shootAntibody(); });

    // --- ENTITAS GAME ---
    class ImmuneCell {
      constructor() {
        this.x = canvas.width / 2;
        this.y = canvas.height / 2;
        this.radius = 28;
        this.speed = 5;
        this.angle = 0;
      }
      draw() {
        ctx.save();
        ctx.translate(this.x, this.y);

        // Fluid Membrane
        ctx.beginPath();
        for (let i = 0; i < 10; i++) {
          let a = (Math.PI * 2 / 10) * i;
          let r = this.radius + Math.sin(time * 4 + i) * 3;
          let px = Math.cos(a) * r;
          let py = Math.sin(a) * r;
          if (i === 0) ctx.moveTo(px, py); else ctx.lineTo(px, py);
        }
        ctx.closePath();
        let bodyGrad = ctx.createRadialGradient(-4, -4, 2, 0, 0, this.radius);
        bodyGrad.addColorStop(0, '#ffffff');
        bodyGrad.addColorStop(0.6, '#b3f0ff');
        bodyGrad.addColorStop(1, '#00c3e6');
        ctx.fillStyle = bodyGrad;
        ctx.shadowColor = '#00f0ff'; ctx.shadowBlur = 15;
        ctx.fill();

        // Nucleus
        ctx.beginPath(); ctx.arc(-2, 0, 10, 0, Math.PI * 2);
        ctx.fillStyle = '#7a00cc'; ctx.fill();

        ctx.restore();
      }
      update() {
        if (keys.up && this.y - this.radius > 0) this.y -= this.speed;
        if (keys.down && this.y + this.radius < canvas.height) this.y += this.speed;
        if (keys.left && this.x - this.radius > 0) this.x -= this.speed;
        if (keys.right && this.x + this.radius < canvas.width) this.x += this.speed;
      }
    }

    class Antibody {
      constructor(x, y) {
        this.x = x; this.y = y; this.speed = 12;
      }
      draw() {
        ctx.save();
        ctx.translate(this.x, this.y);
        ctx.strokeStyle = '#00ffff'; ctx.lineWidth = 3;
        ctx.shadowColor = '#00ffff'; ctx.shadowBlur = 10;
        ctx.beginPath();
        ctx.moveTo(-8, 0); ctx.lineTo(4, 0);
        ctx.moveTo(4, 0); ctx.lineTo(10, -6);
        ctx.moveTo(4, 0); ctx.lineTo(10, 6);
        ctx.stroke();
        ctx.restore();
      }
      update() { this.x += this.speed; }
    }

    // VARIASI 4 VIRUS & PATOGEN BERAGAM
    class Pathogen {
      constructor() {
        this.x = canvas.width + 40;
        this.y = Math.random() * (canvas.height - 80) + 40;
        
        // Pick Random Type
        const types = ['bakteri', 'corona', 'bacteriophage', 'mutant'];
        this.type = types[Math.floor(Math.random() * types.length)];

        if (this.type === 'bakteri') {
          this.radius = 20; this.speed = 1.8; this.hp = 2;
        } else if (this.type === 'corona') {
          this.radius = 16; this.speed = 2.8; this.hp = 1;
        } else if (this.type === 'bacteriophage') {
          this.radius = 18; this.speed = 2.2; this.hp = 2;
        } else { // Mutant
          this.radius = 32; this.speed = 1.0; this.hp = 5;
        }
      }
      draw() {
        ctx.save();
        ctx.translate(this.x, this.y);

        if (this.type === 'bakteri') {
          // Kapsul Orange
          ctx.fillStyle = '#ff4400'; ctx.shadowColor = '#ff4400'; ctx.shadowBlur = 10;
          ctx.beginPath(); ctx.roundRect(-18, -10, 36, 20, 10); ctx.fill();
        } else if (this.type === 'corona') {
          // Corona Pink Berduri
          ctx.fillStyle = '#ff007f'; ctx.shadowColor = '#ff007f'; ctx.shadowBlur = 12;
          ctx.beginPath(); ctx.arc(0, 0, this.radius, 0, Math.PI * 2); ctx.fill();
          for (let i = 0; i < 8; i++) {
            let a = (Math.PI / 4) * i;
            ctx.beginPath();
            ctx.arc(Math.cos(a) * (this.radius + 4), Math.sin(a) * (this.radius + 4), 3, 0, Math.PI*2);
            ctx.fillStyle = '#ffcc00'; ctx.fill();
          }
        } else if (this.type === 'bacteriophage') {
          // Phage Hijau Robotik
          ctx.fillStyle = '#00ff66'; ctx.shadowColor = '#00ff66'; ctx.shadowBlur = 10;
          ctx.beginPath(); ctx.arc(0, -6, 10, 0, Math.PI * 2); ctx.fill();
          ctx.strokeStyle = '#00ff66'; ctx.lineWidth = 2;
          ctx.beginPath(); ctx.moveTo(0, 4); ctx.lineTo(0, 12);
          ctx.moveTo(0, 12); ctx.lineTo(-8, 20);
          ctx.moveTo(0, 12); ctx.lineTo(8, 20); ctx.stroke();
        } else {
          // Mutan Ungu Besar
          ctx.fillStyle = '#a600ff'; ctx.shadowColor = '#a600ff'; ctx.shadowBlur = 15;
          ctx.beginPath(); ctx.arc(0, 0, this.radius, 0, Math.PI * 2); ctx.fill();
          ctx.fillStyle = '#ffff00';
          ctx.beginPath(); ctx.arc(-8, -6, 5, 0, Math.PI*2); ctx.arc(8, -6, 5, 0, Math.PI*2); ctx.fill();
        }

        ctx.restore();
      }
      update() { this.x -= this.speed; }
    }

    class Particle {
      constructor(x, y, color) {
        this.x = x; this.y = y; this.color = color;
        this.radius = Math.random() * 3 + 1;
        this.vx = (Math.random() - 0.5) * 6; this.vy = (Math.random() - 0.5) * 6;
        this.alpha = 1;
      }
      draw() {
        ctx.save(); ctx.globalAlpha = this.alpha;
        ctx.fillStyle = this.color; ctx.beginPath();
        ctx.arc(this.x, this.y, this.radius, 0, Math.PI * 2); ctx.fill();
        ctx.restore();
      }
      update() { this.x += this.vx; this.y += this.vy; this.alpha -= 0.04; }
    }

    // Inisialisasi
    const player = new ImmuneCell();
    let antibodies = [];
    let pathogens = [];
    let particles = [];

    function shootAntibody() {
      if (!gameActive) return;
      antibodies.push(new Antibody(player.x + 20, player.y));
      playSound('shoot');
    }

    setInterval(() => {
      if (gameActive) pathogens.push(new Pathogen());
    }, 1200);

    // --- GAME LOOP ---
    function animate() {
      if (!gameActive) return;
      time += 0.03;

      ctx.clearRect(0, 0, canvas.width, canvas.height);

      // Render Player
      player.update(); player.draw();

      // Render Antibodi
      antibodies.forEach((ab, i) => {
        ab.update(); ab.draw();
        if (ab.x > canvas.width) antibodies.splice(i, 1);
      });

      // Render Patogen
      pathogens.forEach((p, pIndex) => {
        p.update(); p.draw();

        // Kena Tembakan
        antibodies.forEach((ab, abIndex) => {
          let dist = Math.hypot(ab.x - p.x, ab.y - p.y);
          if (dist < p.radius + 6) {
            p.hp--;
            antibodies.splice(abIndex, 1);
            playSound('hit');

            for(let i=0; i<6; i++) particles.push(new Particle(ab.x, ab.y, '#00ffff'));

            if (p.hp <= 0) {
              score += 10;
              scoreVal.innerText = score;
              for(let i=0; i<12; i++) particles.push(new Particle(p.x, p.y, '#ff0055'));
              pathogens.splice(pIndex, 1);
            }
          }
        });

        // Tabrakan dengan Player
        let distPlayer = Math.hypot(player.x - p.x, player.y - p.y);
        if (distPlayer < player.radius + p.radius) {
          hp -= 15;
          hpVal.innerText = Math.max(0, hp);
          playSound('damage');
          for(let i=0; i<10; i++) particles.push(new Particle(p.x, p.y, '#ff0000'));
          pathogens.splice(pIndex, 1);

          if (hp <= 0) endGame();
        }

        // Kena Batas Kiri Layar
        if (p.x < -40) pathogens.splice(pIndex, 1);
      });

      // Partikel Ledakan
      particles.forEach((part, index) => {
        part.update(); part.draw();
        if (part.alpha <= 0) particles.splice(index, 1);
      });

      requestAnimationFrame(animate);
    }

    function endGame() {
      gameActive = false;
      finalScore.innerText = score;
      gameOverScreen.classList.remove('hidden');
    }

    function restartGame() {
      hp = 100; score = 0;
      hpVal.innerText = hp; scoreVal.innerText = score;
      pathogens = []; antibodies = []; particles = [];
      gameActive = true;
      gameOverScreen.classList.add('hidden');
      animate();
    }

    animate();
  </script>
</body>
</html>
